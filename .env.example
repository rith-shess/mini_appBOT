# Server-side Environment Variables (Set in Vercel Project Settings)
# NEVER commit the real .env file or real bot token to GitHub!

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Sales Desk Telegram Chat ID (numeric chat ID, e.g. 1256184682 for @Skybalsupport)
TELEGRAM_SALES_CHAT_ID=1256184682

# Telegram Webhook Secret Token (for X-Telegram-Bot-Api-Secret-Token verification)
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here

# Optional: Public base URL if calling custom backend API
VITE_API_BASE_URL=

# Optional Telegram Bot Username for web links
VITE_TELEGRAM_BOT_USERNAME=InfoPOSMini_StoreBot

# Shared product database (Vercel > Storage > Upstash Redis sets these automatically)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Who may add/edit/delete products (checked on the server via Telegram initData)
# ADMIN_TELEGRAM_USERNAMES=rith_shees,Skybalsupport
# ADMIN_TELEGRAM_IDS=

# Password for the browser admin page at /admin (min 8 characters, long and random, only in Vercel)
# ADMIN_PASSWORD=
# Optional: separate secret used to sign login cookies
# ADMIN_SESSION_SECRET=
