# Backend Node.js Environment Variables (Private - do not commit to GitHub)

# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Sales Telegram Chat ID (numeric chat ID, e.g. 1256184682)
TELEGRAM_SALES_CHAT_ID=1256184682

# Telegram Webhook Secret Token (optional for local/server verification)
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here

# Server Port (default 4000)
PORT=4000

# Frontend URL
FRONTEND_URL=http://localhost:5173
