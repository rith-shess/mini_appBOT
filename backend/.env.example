# Telegram Bot Token (obtain from @BotFather for @InfoPOSMini_StoreBot)
TELEGRAM_BOT_TOKEN=

# Sales Telegram Chat ID or Group ID (where new orders are sent with [Approve] / [Reject] buttons)
